# TRAXUP Imobiliário — configuração do servidor
# Copie para .env e preencha. Nunca envie o .env para o GitHub.

PORT=3000
# use 127.0.0.1 atrás do Nginx; 0.0.0.0 para acesso direto
HOST=127.0.0.1
# onde ficam db.json e os backups diários (últimos 30)
DATA_DIR=data
SESSION_HOURS=12

# Discord (nome exibido nas mensagens)
DISCORD_USERNAME=TRAXUP Imobiliário

# Banco do Brasil — API de Cobrança v2 (https://developers.bb.com.br)
# sandbox = homologação (api.hm.bb.com.br) · producao = api.bb.com.br
BB_AMBIENTE=sandbox
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_DEV_APP_KEY=
# Certificado digital (mTLS), quando o BB exigir no seu convênio — arquivo .pfx/.p12
BB_CERT_PFX=
BB_CERT_PASS=
# Gerar QR Code PIX junto com o boleto (S/N)
BB_PIX=S
# Dias após o vencimento em que o boleto ainda pode ser pago
BB_DIAS_LIMITE=60

# Endereço público do sistema (usado nos links dos e-mails)
APP_URL=https://imob.traxup.com.br

# E-mail de envio (redefinição de senha). Hostinger: smtp.hostinger.com, porta 465 (SSL)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=naoresponda@traxup.com.br
SMTP_PASS=
SMTP_FROM=naoresponda@traxup.com.br
SMTP_NOME=TRAXUP Imobiliário

# Cotações (opcional): chave grátis em awesomeapi.com.br para cotações em tempo real
AWESOMEAPI_TOKEN=
